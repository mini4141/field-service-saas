# Copy to .env for local dev (real .env is gitignored)
NODE_ENV=development
DATABASE_URL=postgresql://fss:fss@localhost:5432/fss?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-only-change-me
INTERNAL_HMAC_SECRET=dev-only-hmac
API_PORT=4000
WEB_PORT=3000
MOBILE_PORT=8081
# Public base URL of the API as seen by browsers
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
# S3 (local = moto)
S3_BUCKET=fss-assets
S3_REGION=ap-southeast-2
S3_ENDPOINT=http://localhost:5000
# Browser-facing S3 endpoint used inside presigned URLs
S3_PUBLIC_ENDPOINT=http://localhost:5000
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
