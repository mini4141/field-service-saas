{
  "extends": "@fss/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "declaration": false,
    "types": []
  },
  "include": ["src", "e2e", "vitest.config.ts", "playwright.config.ts"]
}
