{
  "name": "@fss/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start --web --port ${MOBILE_PORT:-8081}",
    "build": "expo export --platform web",
    "lint": "eslint src e2e",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@fss/api-client": "workspace:*",
    "expo": "~54.0.0",
    "expo-image-picker": "~17.0.8",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.6",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@fss/config": "workspace:*",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "~19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "babel-preset-expo": "~54.0.12",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
